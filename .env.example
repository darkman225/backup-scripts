# SSH connection
SSH_HOST=192.168.1.10
SSH_PORT=22
SSH_USER=myuser
SSH_PASSWORD=
SSH_KEY_PATH=/Users/username/.ssh/id_rsa
SSH_KEY_PASSPHRASE=

# Security
SSH_KNOWN_HOSTS=/Users/username/.ssh/known_hosts
STRICT_HOST_KEY_CHECKING=true

# Remote behavior
REMOTE_DIR=/var/backups
# If set, script runs this command first and tries to download the generated file
REMOTE_COMMAND=

# Optional filter (comma-separated), e.g. *.log,*.txt
FILE_PATTERNS=

# Local output
LOCAL_OUTPUT_DIR=./downloads
