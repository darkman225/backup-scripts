# SSH connection
SSH_HOST=192.168.1.10
SSH_PORT=22
SSH_USER=myuser
SSH_PASSWORD=
SSH_KEY_PATH=/Users/username/.ssh/id_rsa
SSH_KEY_PASSPHRASE=

# Security
SSH_KNOWN_HOSTS=/Users/username/.ssh/known_hosts
STRICT_HOST_KEY_CHECKING=true

# Remote behavior
REMOTE_DIR=/var/backups
# If set, script runs this command first and tries to download the generated file
REMOTE_COMMAND=

# Optional filter (comma-separated), e.g. *.log,*.txt
FILE_PATTERNS=

# Local output
LOCAL_OUTPUT_DIR=./downloads

# Optional execution report endpoint (BK/HC scripts -> backend /executions/report/v2)
EXECUTION_REPORT_V2_URL=
EXECUTION_REPORT_API_KEY=
EXECUTION_REPORT_TIMEOUT_SECONDS=15
EXECUTION_REPORT_STORAGE_BACKEND=LOCAL_FS
EXECUTION_REPORT_STORAGE_ROOT_ALIAS=local_backup

# Execution metadata
COUNTRY_CODE=CI
SERVICE_DOMAIN=VAS
EXECUTION_TYPE=BK
APP_ENV=prod
SCRIPT_VERSION=1.0.0
